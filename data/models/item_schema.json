{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Item",
  "type": "object",
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["consumable","weapon","armor","material"] },
    "price": { "type": "integer", "minimum": 0 },
    "effects": { "type": "object" }
  },
  "required": ["id","name","type"]
}
